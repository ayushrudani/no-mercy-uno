NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# SQLite. In production this lives on a mounted volume so a redeploy keeps it.
DATABASE_URL="file:./dev.db"

# Anyone who knows this code can create an account. Change it if it leaks --
# existing accounts are unaffected, only new signups need the current value.
SIGNUP_CODE=94997749

# openssl rand -base64 48
SESSION_SECRET=replace-me-with-at-least-32-characters-of-random
SESSION_TTL_DAYS=30

CORS_ORIGINS=http://localhost:5173

# Production only: absolute path to the built client.
# WEB_DIST=/app/web

RECONNECT_GRACE_SECONDS=120
ROOM_TTL_MINUTES=180

# --- Voice (WebRTC) ---
# STUN is enough for many networks; TURN is the fallback that makes voice work
# across the NAT combinations STUN cannot punch through. On different ISPs in
# different cities you WILL need TURN.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN_URLS=turn:uno.bunkcode.online:3478,turns:uno.bunkcode.online:5349
# Must equal coturn's static-auth-secret. openssl rand -hex 32
# TURN_SECRET=
TURN_TTL_SECONDS=3600
