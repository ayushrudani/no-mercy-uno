// Persistence for accounts, profile settings and match history.
//
// SQLite rather than Postgres: this serves one friend group on a single box,
// and reads/writes are tiny and infrequent. It removes a container from the
// Lightsail deployment and makes backups "copy one file". Prisma keeps the
// door open -- moving to Postgres later is a provider swap plus a migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())

  /// Login identity. Stored already normalised to lower case by the API.
  username     String @unique
  /// scrypt, in the self-describing format from auth/password.ts. Never a
  /// plaintext password, and never returned by any route.
  passwordHash String

  /// Set on signup, cleared by the first password change. While it is true the
  /// account can only be issued a reset-scoped token, so it cannot join a room
  /// or open a socket until the signup password has been replaced.
  mustResetPassword Boolean @default(true)

  displayName String
  avatarUrl   String?

  // Profile settings, mirrored into the client on login.
  /// "dealt" or "color". Defaulted, so adding it needed no destructive push.
  handSort             String  @default("dealt")
  cardBack             String  @default("classic")
  sfxVolume            Int     @default(70)
  micDefaultOn         Boolean @default(true)
  preferredTurnSeconds Int     @default(30)

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  matches MatchPlayer[]

  @@index([lastSeenAt])
}

model Match {
  id       String @id @default(cuid())
  roomCode String

  startedAt DateTime  @default(now())
  endedAt   DateTime?
  rounds    Int       @default(0)
  winnerId  String?

  players MatchPlayer[]

  @@index([roomCode])
  @@index([startedAt])
}

model MatchPlayer {
  id String @id @default(cuid())

  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  seat      Int
  roundsWon Int  @default(0)
  /// 1 = won the game. Higher numbers were eliminated earlier.
  finalPlace Int?

  @@unique([matchId, userId])
  @@index([userId])
}
